{
  "rules": {
    "users": {
      "$uid": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'",
        ".read": "auth != null",
        ".validate": "newData.child('role').val() === 'student'"
      }
    },
    "teachers": {
      "$tid": {
        ".write": "$tid === auth.uid",
        ".read": "$tid === auth.uid"
      }
    },
    "students": {
      "$sid": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'",
        ".read": "$sid === auth.uid"
      }
    },
    "homework": {
      "teachers": {
        "$tid": {
          ".write": "$tid === auth.uid",
          ".read": "$tid === auth.uid",
          "students": {
            "$sid": {
              ".read": "$tid === auth.uid || $sid === auth.uid",
              "$hid": {
                ".read": "$tid === auth.uid || ($sid === auth.uid && data.child('visible_to_student').val() === true)"
              }
            }
          }
        }
      }
    },
    "resources": {
      "teachers": {
        "$tid": {
          ".write": "$tid === auth.uid",
          ".read": "$tid === auth.uid || auth != null"
        }
      }
    },
    "shared-resources": {
      "$tid": {
        "students": {
          "$sid": {
            ".write": "$tid === auth.uid",
            ".read": "$tid === auth.uid || $sid === auth.uid"
          }
        }
      }
    },
    "deleted": {
      "homework": {
        "teachers": {
          "$tid": {
            ".write": "$tid === auth.uid"
          }
        }
      },
      "resources": {
        "teachers": {
          "$tid": {
            ".write": "$tid === auth.uid"
          }
        }
      },
      "videos": {
        "teachers": {
          "CgOaIwnaE5TPVsiRrsB9krTaC092": {
            ".read": true,
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'"
          }
        }
      },
      "posts": {
        "teachers": {
          "CgOaIwnaE5TPVsiRrsB9krTaC092": {
            ".read": true,
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'"
          }
        }
      }
    },
    "videos": {
      "teachers": {
        "CgOaIwnaE5TPVsiRrsB9krTaC092": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'"
        }
      },
      "showcase": {
        "teachers": {
          "CgOaIwnaE5TPVsiRrsB9krTaC092": {
            ".read": true,
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'"
          }
        }
      }
    },
    "posts": {
      "teachers": {
        "CgOaIwnaE5TPVsiRrsB9krTaC092": {
          ".read": true,
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'"
        }
      }
    },
    "announcement": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'teacher'"
    },
    "lessons": { ".read": "auth != null", ".write": "auth != null" },
    "teacherLessons": { ".read": "auth != null", ".write": "auth != null" },
    "studentLessons": { ".read": "auth != null", ".write": "auth != null" },
    "groupClasses": { ".read": "auth != null", ".write": "auth != null" },
    "teacherGroupClasses": { ".read": "auth != null", ".write": "auth != null" },
    "studentGroupClasses": { ".read": "auth != null", ".write": "auth != null" }
  }
}
